<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mtx.rdp</groupId>
        <artifactId>mtx-data-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>platform-core</artifactId>
    <name>platform-core</name>
    <description>Capability boundaries. No infrastructure client dependencies.</description>

    <dependencies>
        <dependency>
            <groupId>com.mtx.rdp</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-infrastructure-frameworks</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- 只约束本模块。searchTransitive 同时检查直接依赖和传递依赖。 -->
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>org.springframework.data:spring-data-redis</exclude>
                                        <exclude>org.apache.kafka:*</exclude>
                                        <exclude>org.springframework.kafka:*</exclude>
                                        <exclude>org.mybatis:*</exclude>
                                        <exclude>com.baomidou:*</exclude>
                                        <exclude>org.quartz-scheduler:*</exclude>
                                        <exclude>redis.clients:*</exclude>
                                        <exclude>io.lettuce:*</exclude>
                                        <exclude>com.mysql:*</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.apache.doris:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
