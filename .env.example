# 本地 DEV_ONLY 凭据。复制为仓库根目录的 .env 后填写。
# .env 已被 Git 忽略。不要把口令写进 Java、YAML、SQL 或提交。
# 应用拒绝 root。账号只授予 mtx_rdp_dev_only。

MTX_RDP_DEV_MYSQL_USER=
MTX_RDP_DEV_MYSQL_PASSWORD=
MTX_RDP_DEV_DORIS_USER=
MTX_RDP_DEV_DORIS_PASSWORD=

# 下面有开发测试默认值，需要时再覆盖。
# MTX_RDP_DEV_KAFKA_BOOTSTRAP=192.168.1.51:9092
# MTX_RDP_DEV_MYSQL_HOST=192.168.1.50
# MTX_RDP_DEV_MYSQL_PORT=3306
# MTX_RDP_DEV_MYSQL_DATABASE=mtx_rdp_dev_only
# MTX_RDP_DEV_DORIS_HOST=192.168.1.50
# MTX_RDP_DEV_DORIS_HTTP_PORT=8030
# MTX_RDP_DEV_DORIS_QUERY_PORT=9030
# MTX_RDP_DEV_DORIS_DATABASE=mtx_rdp_dev_only
# MTX_RDP_DEV_DORIS_BE=192.168.1.50:8040,192.168.1.51:8040
