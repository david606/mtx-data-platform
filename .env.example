# 复制为仓库根目录的 .env.company 后填写。Spring Boot 不会自动读取 .env.company。
# 启动前由 shell、IDE Run Configuration 或 scripts/start-*.sh 所在的环境导出这些变量。
# .env.company、.env.company.local、.env.company.company 已被 Git 忽略。这里的值都是无效示例，不能当作真实口令。
# 应用拒绝 root。开发连接只允许 DEV_ONLY 范围。

MTX_RDP_DEV_MYSQL_USER=invalid-user
MTX_RDP_DEV_MYSQL_PASSWORD=invalid-password
MTX_RDP_DEV_DORIS_USER=invalid-user
MTX_RDP_DEV_DORIS_PASSWORD=invalid-password

# DEV_ONLY 手工入口不读取 Spring profile。公司主机是 192.168.1.50 和 192.168.1.51，家庭主机是 127.0.0.1。
# 端口和库名两边相同。地址没有默认值，缺少时失败。
# MTX_RDP_DEV_KAFKA_BOOTSTRAP=127.0.0.1:9092
# MTX_RDP_DEV_MYSQL_HOST=127.0.0.1
# MTX_RDP_DEV_MYSQL_PORT=3306
# MTX_RDP_DEV_MYSQL_DATABASE=mtx_rdp_dev_only
# MTX_RDP_DEV_DORIS_HOST=127.0.0.1
# MTX_RDP_DEV_DORIS_HTTP_PORT=8030
# MTX_RDP_DEV_DORIS_QUERY_PORT=9030
# MTX_RDP_DEV_DORIS_DATABASE=mtx_rdp_dev_only
# MTX_RDP_DEV_DORIS_BE=127.0.0.1:8040
